# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Packaging and builds ──────────────────────────────────────────
build/
dist/
wheels/
.eggs/
*.egg-info/
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
# Lock files are not committed for this library (the CI resolves the extras of pyproject.toml)
uv.lock
poetry.lock

# ── Virtual environments ──────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Tests, coverage and tool caches ───────────────────────────────
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
cover/
*.cover
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/
.cache

# ── Documentation (MkDocs output) ─────────────────────────────────
/site/

# ── Jupyter ───────────────────────────────────────────────────────
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ── Experiment output ─────────────────────────────────────────────
# Default file names of JSONLCallback / CSVCallback when run from the repository root.
experiment_output.*
# Results written by the example notebooks. The three sample files below are tracked.
examples/data/output/*
!examples/data/output/bfi_demo_config_output.csv
!examples/data/output/bfi_demo_config_output.jsonl
!examples/data/output/bfi_demo_config_output_processed.csv

# ── Secrets and local configuration ───────────────────────────────
# Experiment configurations may contain API keys: never commit them (see SECURITY.md).
.env
.env.*
!.env.example
.pypirc
.claude/settings.local.json

# ── Logs ──────────────────────────────────────────────────────────
*.log

# ── Editors and operating systems ─────────────────────────────────
# Only the shared VS Code settings are tracked.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
