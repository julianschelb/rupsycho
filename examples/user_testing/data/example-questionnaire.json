{
    "name": "Generative Models for Simple Preferences Survey",
    "description": "Testing Generative Models for a simple preferences survey using RUPsycho.",
    "parameters": {
        "seeds": [
            "7"
        ]
    },
    "models": {
        "remote_model": {
            "type": "remote_huggingface",
            "repo_id": "HuggingFaceH4/zephyr-7b-beta",
            "task": "text-generation",
            "parameters": {
                "max_new_tokens": 128,
                "temperature": 0.8,
                "top_k": 50,
                "top_p": 0.95,
                "do_sample": true,
                "repetition_penalty": 1.2,
                "return_full_text": false
            }
        }
    },
    "prompt_template": {
        "type": "chat",
        "messages": [
            {
                "role": "system",
                "content": "Objective: \"{general_instruction}\" Answer as the person described."
            },
            {
                "role": "user",
                "content": "\nInstructions: Choose from the list of answer options to answer the question. Answer the question by stating one of the listed answer options and nothing else! If none of the options are correct, choose the option that is closest to being correct.\nPlease answer as this person: \"{persona_description}\". Question: Does this person ... \"{question}\"?\nAnswer Options: \"{answer_options}\"\nWhat is your answer?"
            }
        ]
    },
    "demographic_profiles": {
        "Optimistic Persona": {
            "attributes": {
                "age": 18,
                "title": "Ms",
                "name": "Muller"
            },
            "template": "{title} {name} is {age} years old, very open-minded, and has an optimistic personality. She likes pink and strawberry ice cream."
        },
        "Conservative Persona": {
            "attributes": {
                "age": 65,
                "title": "Mr",
                "name": "Grueber"
            },
            "template": "{title} {name} is {age} years old, very conservative, and has a reserved personality. He likes blue and chocolate ice cream."
        }
    },
    "questionnaire": {
        "name": "Simple Preferences Survey",
        "general_instruction": "Please answer the following questions by selecting the option that best matches your preference.",
        "instruction_items": [
            {
                "question": "What is your favorite color?",
                "answer_options": {
                    "Red": {
                        "text": "Red",
                        "weight": 1
                    },
                    "Blue": {
                        "text": "Blue",
                        "weight": 2
                    },
                    "Green": {
                        "text": "Green",
                        "weight": 3
                    },
                    "Yellow": {
                        "text": "Yellow",
                        "weight": 4
                    },
                    "Other": {
                        "text": "Other",
                        "weight": 5
                    }
                }
            },
            {
                "question": "What is your favorite ice cream flavor?",
                "answer_options": {
                    "Vanilla": {
                        "text": "Vanilla",
                        "weight": 1
                    },
                    "Chocolate": {
                        "text": "Chocolate",
                        "weight": 2
                    },
                    "Strawberry": {
                        "text": "Strawberry",
                        "weight": 3
                    },
                    "Mint": {
                        "text": "Mint",
                        "weight": 4
                    },
                    "Other": {
                        "text": "Other",
                        "weight": 5
                    }
                }
            }
        ]
    }
}